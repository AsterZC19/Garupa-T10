# ============================================================================
# 月榜数据源配置
# 月榜数据来自 GarupaSpeedTracker 后端（StarFreedomX/GarupaSpeedTracker），
# 该后端已持有官方 garupa API 的设备签名。复制为 backend/.env 后填写。
# ============================================================================

# 【必填】GarupaSpeedTracker 后端 API 基址。
# 本机 docker compose 部署默认 http://127.0.0.1:5519/api；远程部署填完整地址。
# GARUPA_TRACKER_BASE=http://127.0.0.1:5519/api

# tracker 后端服务器索引（0=日服，1=国际服，2=台服，3=国服）
# GARUPA_TRACKER_SERVER=0

# tracker 请求超时（秒）
# GARUPA_TRACKER_TIMEOUT=30
